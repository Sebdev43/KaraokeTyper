{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "karaoketyper",
  "version": "1.0.8",
  "identifier": "com.seb43.karaoketyper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "features": ["gpu-vulkan"]
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "KaraokeTyper Settings",
        "url": "settings.html",
        "width": 820,
        "height": 620,
        "resizable": true,
        "center": true,
        "visible": false,
        "skipTaskbar": false,
        "decorations": false
      },
      {
        "label": "overlay",
        "title": "Recording",
        "url": "overlay.html",
        "width": 160,
        "height": 50,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "center": false,
        "x": 20,
        "y": 80,
        "skipTaskbar": true,
        "transparent": true,
        "backgroundColor": [0, 0, 0, 0],
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/focused-window-dbus/*": "focused-window-dbus/",
      "resources/models/silero_vad_v4.onnx": "models/silero_vad_v4.onnx",
      "resources/sounds/*": "sounds/"
    },
    "linux": {
      "deb": {
        "section": "utils",
        "priority": "optional",
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libasound2"],
        "postRemoveScript": "debian/postrm"
      }
    }
  }
}
