{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "karaoketyper",
  "version": "1.5.1",
  "identifier": "com.seb43.karaoketyper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "features": ["gpu-vulkan"]
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "KaraokeTyper Settings",
        "url": "settings.html",
        "width": 820,
        "height": 620,
        "resizable": true,
        "center": true,
        "visible": false,
        "skipTaskbar": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://localhost:*"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3RUQ4OEY2MURBRTRFRkQKUldUOVRxNGQ5b2p0MTZZaStPc1diQm1PRXFXQU14aEFYYUUwbXgyZWwra2p2Z3VCcW10ZjdzZ2QK",
      "endpoints": [
        "https://github.com/Sebdev43/KaraokeTyper/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/focused-window-dbus/*": "focused-window-dbus/",
      "resources/models/silero_vad_v4.onnx": "models/silero_vad_v4.onnx",
      "resources/sounds/*": "sounds/"
    },
    "linux": {
      "deb": {
        "section": "utils",
        "priority": "optional",
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libasound2", "xclip", "xdotool"],
        "postRemoveScript": "debian/postrm"
      }
    }
  }
}
