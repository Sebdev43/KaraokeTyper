{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "karaoketyper",
  "version": "0.1.0",
  "identifier": "com.seb43.karaoketyper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "KaraokeTyper Settings",
        "url": "settings.html",
        "width": 600,
        "height": 540,
        "resizable": true,
        "center": true,
        "visible": false,
        "skipTaskbar": false,
        "decorations": true
      },
      {
        "label": "overlay",
        "title": "Recording",
        "url": "overlay.html",
        "width": 160,
        "height": 50,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "center": false,
        "x": 20,
        "y": 80,
        "skipTaskbar": true,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "python/*": "python/"
    },
    "linux": {
      "deb": {
        "section": "utils",
        "priority": "optional",
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libasound2"],
        "postRemoveScript": "debian/postrm"
      }
    }
  }
}
