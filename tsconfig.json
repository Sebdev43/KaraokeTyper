{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path aliases for shadcn/ui (relative to this file; baseUrl is gone in TS 7) */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Linting.
       Unused locals and parameters are Biome's job, not tsc's: `src/bindings.ts`
       is generated by tauri-specta and declares a channel helper and an event
       factory it does not itself use, so tsc flagged two errors on every run and
       any hand-edit would be overwritten at the next `tauri dev`. Biome already
       excludes that one file and now treats noUnusedVariables/noUnusedImports as
       errors, so the check still covers every file we actually write. */
    "strict": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
